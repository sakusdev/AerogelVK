#version 460

// ValkyrieRender - Phase 4 GPU-Driven Frustum + Hi-Z Occlusion Culling Compute Shader
// Culls chunk sections on GPU and generates VkDrawIndexedIndirectCommand buffer for vkCmdDrawIndexedIndirectCount.

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

// Set 0, Binding 0: Frame Uniform Buffer
layout(std140, set = 0, binding = 0) uniform FrameData {
    mat4 view;
    mat4 proj;
    mat4 viewProj;
    mat4 invViewProj;
    mat4 prevViewProj;
    mat4 csmMatrices[3];
    vec4 sunDir;
    vec4 cameraPos;
    vec2 viewportSize;
    uint frameIndex;
    float time;
    uint renderFlags;
    uint activeCascades;
    float csmFarDist;
    float reserved0;
} FrameUBO;

// Set 0, Binding 2: Chunk Metadata SSBO (32-byte aligned)
struct ChunkDrawMeta {
    ivec3 chunkPos;       // World Chunk Section Coordinate (sectionX, sectionY, sectionZ)
    uint vertexOffset;    // Offset (in vertices) into Global Mega-Vertex Buffer
    uint quadCount;       // Number of quads in this section
    uint aabbPacked;      // [0..4]minX, [5..9]minY, [10..14]minZ, [15..19]maxX, [20..24]maxY, [25..29]maxZ
    uint flags;           // Bit 0: HasTranslucent, Bit 1: DirtyShadow
    uint padding;         // 32-Byte Alignment
};

layout(std430, set = 0, binding = 2) readonly buffer ChunkMetaSSBO {
    ChunkDrawMeta chunks[];
};

// Set 0, Binding 3: Indirect Draw Command Buffer
struct VkDrawIndexedIndirectCommand {
    uint indexCount;
    uint instanceCount;
    uint firstIndex;
    int  vertexOffset;
    uint firstInstance;
};

layout(std430, set = 0, binding = 3) buffer IndirectCmdSSBO {
    VkDrawIndexedIndirectCommand cmds[];
};

// Set 0, Binding 4: Draw Count SSBO
layout(std430, set = 0, binding = 4) buffer DrawCountSSBO {
    uint visibleChunkCount;
};

// Set 0, Binding 5: Instance Index to Chunk Metadata Index mapping
layout(std430, set = 0, binding = 5) buffer VisibleChunkIdSSBO {
    uint instanceToChunkIdx[];
};

// Set 1, Binding 3: Hi-Z Occlusion Pyramid Mip Chain
layout(set = 1, binding = 3) uniform sampler2D uHiZPyramid;

layout(push_constant) uniform CullPushConstants {
    uint totalChunkCount;
    uint hiZEnabled;
    uint passFlagFilter; // 0=all, 1=opaque ((flags & 1u)==0u), 2=translucent ((flags & 1u)!=0u)
} pc;

void main() {
    uint chunkIdx = gl_GlobalInvocationID.x;
    if (chunkIdx >= pc.totalChunkCount) {
        return;
    }

    ChunkDrawMeta meta = chunks[chunkIdx];
    if (meta.quadCount == 0u) {
        return; // Empty section, no quads
    }
    if (pc.passFlagFilter == 1u && (meta.flags & 1u) != 0u) {
        return;
    }
    if (pc.passFlagFilter == 2u && (meta.flags & 1u) == 0u) {
        return;
    }

    // Unpack local section AABB [0..31]
    uint minX = (meta.aabbPacked) & 0x1Fu;
    uint minY = (meta.aabbPacked >> 5) & 0x1Fu;
    uint minZ = (meta.aabbPacked >> 10) & 0x1Fu;
    uint maxX = (meta.aabbPacked >> 15) & 0x1Fu;
    uint maxY = (meta.aabbPacked >> 20) & 0x1Fu;
    uint maxZ = (meta.aabbPacked >> 25) & 0x1Fu;

    if (maxX < minX || maxY < minY || maxZ < minZ) {
        return; // Invalid or empty bounding box
    }

    // World-space section origin (16 blocks per section)
    vec3 sectionOrigin = vec3(meta.chunkPos) * 16.0;
    vec3 worldMin = sectionOrigin + vec3(float(minX), float(minY), float(minZ));
    vec3 worldMax = sectionOrigin + vec3(float(maxX), float(maxY), float(maxZ));

    // Calculate 8 corners in world space and transform to clip space
    vec4 corners[8];
    corners[0] = FrameUBO.viewProj * vec4(worldMin.x, worldMin.y, worldMin.z, 1.0);
    corners[1] = FrameUBO.viewProj * vec4(worldMax.x, worldMin.y, worldMin.z, 1.0);
    corners[2] = FrameUBO.viewProj * vec4(worldMin.x, worldMax.y, worldMin.z, 1.0);
    corners[3] = FrameUBO.viewProj * vec4(worldMax.x, worldMax.y, worldMin.z, 1.0);
    corners[4] = FrameUBO.viewProj * vec4(worldMin.x, worldMin.y, worldMax.z, 1.0);
    corners[5] = FrameUBO.viewProj * vec4(worldMax.x, worldMin.y, worldMax.z, 1.0);
    corners[6] = FrameUBO.viewProj * vec4(worldMin.x, worldMax.y, worldMax.z, 1.0);
    corners[7] = FrameUBO.viewProj * vec4(worldMax.x, worldMax.y, worldMax.z, 1.0);

    // 6-Plane Frustum Culling in clip space
    // Standard Vulkan clip space: -w <= x <= w, -w <= y <= w, 0 <= z <= w
    int outside[6] = int[6](0, 0, 0, 0, 0, 0);
    bool intersectsNearPlane = false;

    for (int i = 0; i < 8; ++i) {
        vec4 c = corners[i];
        if (c.x < -c.w) outside[0]++;
        if (c.x >  c.w) outside[1]++;
        if (c.y < -c.w) outside[2]++;
        if (c.y >  c.w) outside[3]++;
        if (c.z <  0.0) outside[4]++;
        if (c.z >  c.w) outside[5]++;
        if (c.w <= 0.0 || c.z < 0.0) {
            intersectsNearPlane = true;
        }
    }

    for (int p = 0; p < 6; ++p) {
        if (outside[p] == 8) {
            return; // All 8 corners outside of plane p -> Culled
        }
    }

    // Hi-Z Occlusion Testing (Reversed-Z: 1.0 = near, 0.0 = far)
    if (pc.hiZEnabled != 0u && !intersectsNearPlane) {
        vec2 minUV = vec2(1.0);
        vec2 maxUV = vec2(0.0);
        float maxZ = 0.0; // In Reversed-Z, maxZ is the closest depth to the camera

        for (int i = 0; i < 8; ++i) {
            vec3 ndc = corners[i].xyz / corners[i].w;
            vec2 uv = ndc.xy * 0.5 + 0.5;
            minUV = min(minUV, uv);
            maxUV = max(maxUV, uv);
            maxZ = max(maxZ, ndc.z);
        }

        minUV = clamp(minUV, vec2(0.0), vec2(1.0));
        maxUV = clamp(maxUV, vec2(0.0), vec2(1.0));

        vec2 boxSize = (maxUV - minUV) * FrameUBO.viewportSize;
        float maxDim = max(boxSize.x, boxSize.y);
        float mip = floor(log2(max(maxDim, 1.0)));

        // Sample Hi-Z pyramid at mip level (4 bounding samples)
        float d0 = textureLod(uHiZPyramid, minUV, mip).r;
        float d1 = textureLod(uHiZPyramid, vec2(maxUV.x, minUV.y), mip).r;
        float d2 = textureLod(uHiZPyramid, vec2(minUV.x, maxUV.y), mip).r;
        float d3 = textureLod(uHiZPyramid, maxUV, mip).r;
        float furthestOccluder = min(min(d0, d1), min(d2, d3));

        // If the closest point of the bounding box is further than the furthest occluder, it is fully occluded
        if (maxZ < furthestOccluder) {
            return; // Culled by Hi-Z
        }
    }

    // Section is visible: Atomically allocate slot in indirect command buffer
    uint cmdIdx = atomicAdd(visibleChunkCount, 1u);

    cmds[cmdIdx].indexCount = meta.quadCount * 6u;
    cmds[cmdIdx].instanceCount = 1u;
    cmds[cmdIdx].firstIndex = 0u;
    cmds[cmdIdx].vertexOffset = int(meta.vertexOffset);
    cmds[cmdIdx].firstInstance = cmdIdx;

    instanceToChunkIdx[cmdIdx] = chunkIdx;
}
