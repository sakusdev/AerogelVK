#version 460

// ValkyrieRender - Phase 2 Verification Compute Shader
// Generates an animated procedural sky/horizon gradient to verify Vulkan-OpenGL zero-copy interop.

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(set = 1, binding = 6, rgba8) uniform writeonly image2D uSharedColorImg;

layout(push_constant) uniform PushConstants {
    float time;
} pc;

// Simple pseudo-random hash for anti-banding dither
float hash(vec2 p) {
    return fract(sin(dot(p, vec2(12.9898, 78.233))) * 43758.5453);
}

void main() {
    ivec2 pixelCoord = ivec2(gl_GlobalInvocationID.xy);
    ivec2 imgSize = imageSize(uSharedColorImg);

    if (pixelCoord.x >= imgSize.x || pixelCoord.y >= imgSize.y) {
        return;
    }

    vec2 uv = (vec2(pixelCoord) + 0.5) / vec2(imgSize);

    // Animated sun position over time
    float t = pc.time * 0.2;
    vec2 sunPos = vec2(0.5 + 0.35 * cos(t), 0.45 + 0.15 * sin(t));

    // Sky colors (Zenith to Horizon)
    vec3 zenithColor  = vec3(0.06, 0.18, 0.45);
    vec3 midSkyColor  = vec3(0.25, 0.50, 0.82);
    vec3 horizonColor = vec3(0.95, 0.60, 0.28);
    vec3 groundColor  = vec3(0.12, 0.14, 0.16);

    // Compute vertical gradient
    vec3 color;
    if (uv.y < 0.5) {
        // Sky hemisphere (top half in Vulkan Y-down or standard)
        float skyT = uv.y / 0.5;
        color = mix(zenithColor, midSkyColor, skyT);
        color = mix(color, horizonColor, pow(skyT, 4.0));
    } else {
        // Horizon to Ground
        float groundT = (uv.y - 0.5) / 0.5;
        color = mix(horizonColor * 0.7, groundColor, smoothstep(0.0, 0.4, groundT));
    }

    // Solar disk and glow
    float distToSun = length(uv - sunPos);
    float sunGlow = exp(-distToSun * 4.5) * 0.8;
    float sunDisk = smoothstep(0.035, 0.030, distToSun);
    vec3 sunLight = vec3(1.0, 0.9, 0.7) * (sunGlow + sunDisk * 1.5);
    color += sunLight;

    // Triangular noise dither to eliminate 8-bit quantization banding
    float dither = (hash(vec2(pixelCoord)) - 0.5) / 255.0;
    color += vec3(dither);
    color = clamp(color, 0.0, 1.0);

    imageStore(uSharedColorImg, pixelCoord, vec4(color, 1.0));
}
